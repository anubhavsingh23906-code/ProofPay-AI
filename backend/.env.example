# Copy this file to .env and fill in local values.
# Never commit .env or PayPal secrets.

# Local SQLite (default). For production use a PostgreSQL URL, for example from Neon:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=sqlite:///./proofpay.db

# PayPal Sandbox only
PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Frontend origin used for PayPal return/cancel URLs and CORS
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# AI provider. Use ollama on this machine. Use gemini on Render.
# The server never falls back from one provider to the other.
AI_PROVIDER=ollama

# Required only when AI_PROVIDER=gemini. Leave blank locally. Never commit a real key.
GEMINI_API_KEY=
# Fast, low-cost Gemini text model. Change this if Google retires the default.
GEMINI_MODEL=gemini-3.5-flash-lite

# Used only when AI_PROVIDER=ollama.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:1.7b
